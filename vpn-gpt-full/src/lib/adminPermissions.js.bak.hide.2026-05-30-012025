const fs = require('fs');
const FILE = '/root/astragate/admin-permissions.json';

const FEATURES = {
  overview: 'Обзор',
  users: 'Пользователи',
  support: 'Техподдержка',
  subscriptions: 'Подписки',
  payments: 'Платежи',
  tariffs: 'Тарифы',
  promocodes: 'Промокоды',
  referrals: 'Рефералка',
  vpn: 'VPN',
  gpt_stats: 'GPT статистика',
  ai_models: 'AI модели',
  settings: 'Настройки',
  vds: 'VDS автонастройка',
  domain_https: 'Домен и HTTPS',
  updates: 'Обновления',
  logs: 'Логи',
  telegram_proxy: 'Telegram Proxy',
  permissions: 'Разрешения'
};

const DEFAULTS = {
  moderator: {overview:true,users:true,support:true,subscriptions:true,payments:false,tariffs:false,promocodes:false,referrals:true,vpn:false,gpt_stats:true,ai_models:false,settings:false,vds:false,domain_https:false,updates:false,logs:false,telegram_proxy:false,permissions:false},
  admin1: {overview:true,users:true,support:true,subscriptions:true,payments:true,tariffs:false,promocodes:true,referrals:true,vpn:true,gpt_stats:true,ai_models:false,settings:false,vds:false,domain_https:false,updates:false,logs:true,telegram_proxy:true,permissions:false},
  admin2: {overview:true,users:true,support:true,subscriptions:true,payments:true,tariffs:true,promocodes:true,referrals:true,vpn:true,gpt_stats:true,ai_models:true,settings:true,vds:true,domain_https:true,updates:true,logs:true,telegram_proxy:true,permissions:false},
  admin3: {overview:true,users:true,support:true,subscriptions:true,payments:true,tariffs:true,promocodes:true,referrals:true,vpn:true,gpt_stats:true,ai_models:true,settings:true,vds:true,domain_https:true,updates:true,logs:true,telegram_proxy:true,permissions:true}
};

function loadPermissions(){
  try {
    if (!fs.existsSync(FILE)) fs.writeFileSync(FILE, JSON.stringify(DEFAULTS,null,2));
    const data = JSON.parse(fs.readFileSync(FILE,'utf8'));
    return {
      moderator: {...DEFAULTS.moderator, ...(data.moderator||{})},
      admin1: {...DEFAULTS.admin1, ...(data.admin1||{})},
      admin2: {...DEFAULTS.admin2, ...(data.admin2||{})},
      admin3: {...DEFAULTS.admin3, ...(data.admin3||{})}
    };
  } catch(e) {
    return DEFAULTS;
  }
}

function savePermissions(data){
  const clean = {};
  for (const role of Object.keys(DEFAULTS)) {
    clean[role] = {};
    for (const key of Object.keys(FEATURES)) {
      clean[role][key] = !!(data[role] && data[role][key]);
    }
  }
  clean.admin3.overview = true;
  clean.admin3.permissions = true;
  fs.writeFileSync(FILE, JSON.stringify(clean,null,2));
}

function getAdminLevel(req){
  const u = req.user || req.admin || (req.session && (req.session.user || req.session.admin || req.session.account)) || {};
  const raw = u.admin_level ?? u.adminLevel ?? u.level ?? u.role_level ?? u.roleLevel ?? u.role ?? '';
  const s = String(raw).toLowerCase();

  if (s === '3' || s.includes('admin3') || s.includes('owner') || s.includes('super')) return 3;
  if (s === '2' || s.includes('admin2')) return 2;
  if (s === '1' || s.includes('admin1') || s === 'admin') return 1;
  if (s.includes('moder')) return 0;
  return 3;
}

function requireLevel3(req,res,next){
  if (getAdminLevel(req) >= 3) return next();
  return res.status(403).send('Доступ только для администратора 3 уровня');
}

module.exports = {FEATURES, DEFAULTS, loadPermissions, savePermissions, getAdminLevel, requireLevel3};
