<%- include('_layout_open') %>
<h1>AI модели</h1>
<div class="card">
  <h2>Добавить / изменить модель</h2>
  <p class="muted">Коэффициент списания: фактические токены умножаются на это число. Дорогие модели ставь 3–12, дешёвые 1–2.</p>
  <form method="post" action="/admin/ai-models/save" class="form-grid">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>ID для изменения<input name="id" placeholder="пусто для новой"></label>
    <label>Код<input name="code" placeholder="gpt-5.3-codex"></label>
    <label>Провайдер<input name="provider" placeholder="OpenAI / Google"></label>
    <label>Model ID для API<input name="model_id" placeholder="openai/gpt-5.4-mini"></label>
    <label>Название<input name="name" placeholder="GPT 5.4 MINI"></label>
    <label>Вход ₽ / 1M<input name="input_price" type="number" step="0.01" value="0"></label>
    <label>Выход ₽ / 1M<input name="output_price" type="number" step="0.01" value="0"></label>
    <label>Контекст<input name="context_tokens" type="number" value="400000"></label>
    <label>Возможности<input name="capabilities" placeholder="Vision,Tools,Reasoning"></label>
    <label>Коэффициент списания<input name="token_multiplier" type="number" step="0.01" value="1"></label>
    <label>Max output<input name="max_output_tokens" type="number" value="4000"></label>
    <label>Сортировка<input name="sort_order" type="number" value="100"></label>
    <label><input type="checkbox" name="is_active" checked> Активна</label>
    <button>Сохранить модель</button>
  </form>
</div>
<br>
<div class="grid">
<% models.forEach(m=>{ %>
  <div class="card model-card">
    <h2><%= m.name %></h2>
    <p class="muted"><%= m.provider %> · <code><%= m.model_id %></code></p>
    <div class="pill"><%= m.capabilities || 'Text' %></div>
    <div class="grid2 model-price-row">
      <div><span class="muted">Ввод</span><div class="price small-price"><%= m.input_price %> ₽</div><small>за 1M токенов</small></div>
      <div><span class="muted">Вывод</span><div class="price small-price"><%= m.output_price %> ₽</div><small>за 1M токенов</small></div>
    </div>
    <p class="muted">Контекст: <%= m.context_tokens %> · списание ×<%= m.token_multiplier %></p>
    <p>ID: <%= m.id %> · код: <b><%= m.code %></b> · <%= m.is_active?'активна':'выключена' %></p>
    <form method="post" action="/admin/ai-models/<%= m.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="secondary"><%= m.is_active?'Выключить':'Включить' %></button></form>
  </div>
<% }) %>
</div>
<%- include('_layout_close') %>
