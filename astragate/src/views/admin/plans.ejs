<%- include('_layout_open') %>
<h1>Тарифы</h1>
<div class="card">
  <h2>Создать / изменить тариф</h2>
  <form method="post" action="/admin/plans/save" class="form-grid">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>ID для изменения<input name="id" placeholder="оставь пустым для нового"></label>
    <label>Код<input name="code" placeholder="combo-month"></label>
    <label>Название<input name="name" placeholder="VPN + GPT Месяц"></label>
    <label>Тип тарифа<select name="plan_kind"><option value="vpn">Только VPN</option><option value="gpt">Только GPT</option><option value="combo" selected>VPN + GPT</option></select></label>
    <label>Период<select name="period_kind"><option value="daily">Ежедневный</option><option value="weekly">Недельный</option><option value="monthly" selected>Месячный</option><option value="custom">Свой</option></select></label>
    <label>Цена<input name="price" type="number" step="0.01" value="0"></label>
    <label>Валюта<input name="currency" value="RUB"></label>
    <label>Дней<input name="days" type="number" value="30"></label><label>Лимит трафика, GB<input name="total_gb" type="number" min="0" value="0"><small class="muted">0 — без лимита. Для 3x-ui передаётся в лимит клиента.</small></label><label>Лимит устройств<input name="device_limit" type="number" min="0" value="1"><small class="muted">0 — без лимита/для GPT-only, 1/3/5 — лимит устройств для VPN</small></label>
    <label>GPT токены/мес<input name="gpt_monthly_tokens" type="number" value="500000"></label>
    <label>Сортировка<input name="sort_order" type="number" value="100"></label>
    <label>Описание<textarea name="description"></textarea></label>
    <label>Бейдж<input name="display_badge" placeholder="White VPN / PRO"></label>
    <label><input type="checkbox" name="vpn_enabled" checked> VPN включён</label>
    <label><input type="checkbox" name="gpt_enabled" checked> GPT включён</label>
    <label><input type="checkbox" name="white_vpn_enabled"> White VPN</label>
    <label><input type="checkbox" name="is_active" checked> Активен</label>
    <button>Сохранить</button>
  </form>
</div>
<br>
<div class="table-wrap"><table><tr><th>ID</th><th>Код</th><th>Название</th><th>Тип</th><th>Период</th><th>Цена</th><th>Дней</th><th>Устройств</th><th>GB</th><th>VPN</th><th>GPT</th><th>White</th><th>Бейдж</th><th>Активен</th><th></th></tr><% plans.forEach(p=>{ %><tr><td><%= p.id %></td><td><%= p.code %></td><td><%= p.name %></td><td><%= p.plan_kind || '-' %></td><td><%= p.period_kind || '-' %></td><td><%= p.price %> <%= p.currency %></td><td><%= p.days %></td><td><%= p.device_limit || 0 %></td><td><%= p.total_gb && Number(p.total_gb)>0 ? p.total_gb : '∞' %></td><td><%= p.vpn_enabled?'да':'нет' %></td><td><%= p.gpt_enabled?'да':'нет' %></td><td><%= p.white_vpn_enabled?'да':'нет' %></td><td><%= p.display_badge || '-' %></td><td><%= p.is_active?'да':'нет' %></td><td><form method="post" action="/admin/plans/<%= p.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="danger">Скрыть</button></form></td></tr><% }) %></table></div>
<%- include('_layout_close') %>
