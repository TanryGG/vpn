const MENU = [
  {key:'overview', label:'Обзор', href:'/admin'},
  {key:'users', label:'Пользователи', href:'/admin/users'},
  {key:'support', label:'Техподдержка', href:'/admin/support'},
  {key:'subscriptions', label:'Подписки', href:'/admin/subscriptions'},
  {key:'payments', label:'Платежи', href:'/admin/payments'},
  {key:'tariffs', label:'Тарифы', href:'/admin/plans'},
  {key:'promocodes', label:'Промокоды', href:'/admin/promocodes'},
  {key:'referrals', label:'Рефералка', href:'/admin/referrals'},
  {key:'vpn', label:'VPN', href:'/admin/vpn'},
  {key:'gpt_stats', label:'GPT статистика', href:'/admin/gpt'},
  {key:'ai_models', label:'AI модели', href:'/admin/ai-models'},
  {key:'settings', label:'Настройки', href:'/admin/settings'},
