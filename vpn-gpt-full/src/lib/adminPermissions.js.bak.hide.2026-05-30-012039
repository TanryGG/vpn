    vds:false, domain_https:false, updates:false, logs:true,
    telegram_proxy:true, permissions:false
  },
  admin2: {
    overview:true, users:true, support:true, subscriptions:true,
    payments:true, tariffs:true, promocodes:true, referrals:true,
    vpn:true, gpt_stats:true, ai_models:true, settings:true,
    vds:true, domain_https:true, updates:true, logs:true,
