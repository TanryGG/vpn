<%- include('_layout_open') %><h1>Платежи</h1><div class="table-wrap"><table><tr><th>ID</th><th>Email</th><th>Тариф</th><th>Провайдер</th><th>Сумма</th><th>Статус</th><th>Дата</th><th>Действия</th></tr><% payments.forEach(p=>{ %><tr><td><%= p.id %></td><td><%= p.email || '-' %></td><td><%= p.plan_name || '-' %></td><td><%= label('provider', p.provider) %></td><td><%= p.amount %> <%= p.currency %></td><td><%= label('status', p.status) %></td><td><%= p.created_at %></td><td><% if(p.status!=='paid'){ %><form method="post" action="/admin/payments/<%= p.id %>/mark-paid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button>Отметить оплачено</button></form><% } %></td></tr><% }) %></table></div><%- include('_layout_close') %>