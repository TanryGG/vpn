<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %></title>
  <link rel="icon" type="image/png" href="<%= typeof appIcon !== 'undefined' ? appIcon : '/img/app-icon.png' %>">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
  <meta property="og:image" content="/img/brand-hero.png">
  <link rel="stylesheet" href="/css/style.css?v=20260525-full-rebuild">
</head>
<body>
<header class="topbar">
  <a href="/" class="brand">
    <span class="logo logo-img"><img src="<%= typeof appIcon !== 'undefined' ? appIcon : '/img/app-icon.png' %>" alt=""></span>
    <span><%= typeof siteName !== 'undefined' ? siteName : 'AstraGate' %></span>
  </a>
  <button class="mobile-menu-button" type="button" aria-label="Открыть меню" aria-expanded="false" data-mobile-menu-button>
    <span></span><span></span><span></span>
  </button>
  <div class="navlinks" data-mobile-menu>
    <% if (typeof user !== 'undefined' && user) { %>
      <a href="/dashboard">Кабинет</a>
      <a href="/chat">GPT чат</a>
      <a href="/support">Поддержка</a>
      <% if(['moderator','admin_l1','admin_l2','admin_l3','admin'].includes(user.role)){ %><a href="/admin">Админка</a><% } %>
      <form method="post" action="/logout" class="inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="ghost">Выйти</button>
      </form>
    <% } else { %>
      <a href="/login">Вход</a>
      <a class="primary" href="/register">Регистрация</a>
    <% } %>
  </div>
</header>
<script>
(function(){
  const btn=document.querySelector('[data-mobile-menu-button]');
  const menu=document.querySelector('[data-mobile-menu]');
  if(!btn||!menu) return;
  btn.addEventListener('click',()=>{
    const open=document.body.classList.toggle('nav-open');
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  menu.querySelectorAll('a,button').forEach(el=>el.addEventListener('click',()=>{
    if(window.innerWidth<=820){ document.body.classList.remove('nav-open'); btn.setAttribute('aria-expanded','false'); }
  }));
})();
</script>
<main>
  <% if(success&&success.length){ %><div class="alert ok"><%= success[0] %></div><% } %>
  <% if(error&&error.length){ %><div class="alert err"><%= error[0] %></div><% } %>
