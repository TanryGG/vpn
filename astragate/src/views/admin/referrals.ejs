<%- include('_layout_open') %>
<h1>Рефералка</h1>
<div class="card">
  <h2>Настройки</h2>
  <form method="post" action="/admin/referrals/settings" class="form-grid">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Включена<select name="enabled"><option value="false">Нет</option><option value="true" <%= settings['referral.enabled']==='true'?'selected':'' %>>Да</option></select></label>
    <label>Бонус дней рефереру<input name="bonus_days" type="number" value="<%= settings['referral.bonus_days'] || 3 %>"></label>
    <label>Код тарифа бонуса<input name="bonus_plan_code" value="<%= settings['referral.bonus_plan_code'] || 'combo-day' %>"></label>
    <label>Процент комиссии, инфо<input name="percent" type="number" value="<%= settings['referral.percent'] || 0 %>"></label>
    <button>Сохранить</button>
  </form>
</div>
<br>
<div class="table-wrap"><table><tr><th>ID</th><th>Кто пригласил</th><th>Кого пригласил</th><th>Платёж</th><th>Бонус дней</th><th>Статус</th><th>Дата</th></tr><% rows.forEach(r=>{ %><tr><td><%= r.id %></td><td><%= r.referrer_email %></td><td><%= r.referred_email %></td><td><%= r.payment_id || '-' %></td><td><%= r.bonus_days %></td><td><%= label('status', r.status) %></td><td><%= r.created_at %></td></tr><% }) %></table></div>
<%- include('_layout_close') %>
