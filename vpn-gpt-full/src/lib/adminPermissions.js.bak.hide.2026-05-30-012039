  permissions: 'Разрешения'
};

const DEFAULTS = {
  moderator: {
    overview:true, users:true, support:true, subscriptions:true,
    payments:false, tariffs:false, promocodes:false, referrals:true,
    vpn:false, gpt_stats:true, ai_models:false, settings:false,
