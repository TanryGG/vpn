  {key:'logs', label:'Логи', href:'/admin/logs'}
];

function loadPermissions(){
  try {
    if (!fs.existsSync(FILE)) fs.writeFileSync(FILE, JSON.stringify(DEFAULTS, null, 2));
    const data = JSON.parse(fs.readFileSync(FILE, 'utf8'));
    return {
      moderator: {...DEFAULTS.moderator, ...(data.moderator || {})},
      admin1: {...DEFAULTS.admin1, ...(data.admin1 || {})},
      admin2: {...DEFAULTS.admin2, ...(data.admin2 || {})},
      admin3: {...DEFAULTS.admin3, ...(data.admin3 || {})}
    };
  } catch(e) {
    return DEFAULTS;
  }
}

function savePermissions(data){
  const clean = {};
  for (const role of Object.keys(DEFAULTS)) {
    clean[role] = {};
    for (const key of Object.keys(FEATURES)) {
      clean[role][key] = !!(data[role] && data[role][key]);
    }
  }

  clean.admin3.overview = true;
  clean.admin3.permissions = true;

  fs.writeFileSync(FILE, JSON.stringify(clean, null, 2));
}

function currentUser(req){
  return (
    req.user ||
    req.admin ||
    req.account ||
    (req.session && (
      req.session.user ||
      req.session.admin ||
      req.session.account ||
      req.session.profile
    )) ||
    {}
  );
}

function getAdminLevel(req){
  const u = currentUser(req);
  const session = req.session || {};

  const raw =
    u.admin_level ??
    u.adminLevel ??
    u.role_level ??
    u.roleLevel ??
    u.level ??
    session.admin_level ??
    session.adminLevel ??
    session.role_level ??
    session.roleLevel ??
    session.level ??
    '';

  const roleRaw =
    u.admin_role ??
    u.adminRole ??
    u.role ??
    session.admin_role ??
    session.adminRole ??
    session.role ??
    '';

  const n = Number(raw);
  if (n === 3) return 3;
  if (n === 2) return 2;
  if (n === 1) return 1;
  if (n === 0) return 0;

  const role = String(roleRaw || raw || '').toLowerCase();

  if (
    role.includes('admin3') ||
    role.includes('admin_3') ||
    role.includes('level3') ||
    role.includes('level_3') ||
    role.includes('owner') ||
    role.includes('super') ||
    role.includes('root')
  ) return 3;

  if (
    role.includes('admin2') ||
    role.includes('admin_2') ||
    role.includes('level2') ||
    role.includes('level_2')
  ) return 2;

  if (
    role.includes('admin1') ||
    role.includes('admin_1') ||
    role.includes('level1') ||
    role.includes('level_1')
  ) return 1;

  if (
    role.includes('moder') ||
    role.includes('модер')
  ) return 0;

  // ВАЖНО:
  // старый проект часто хранит главного админа просто как role="admin".
  // Чтобы владелец не потерял доступ к разрешениям, legacy admin = admin3.
  if (role === 'admin' || role === 'administrator' || role === 'админ') return 3;

  // Если пользователь уже попал в /admin, но роль не распознана — не ломаем админку.
  return 3;
}

function roleKeyByLevel(level){
  if (level >= 3) return 'admin3';
  if (level === 2) return 'admin2';
  if (level === 1) return 'admin1';
  return 'moderator';
}

function can(req, feature){
  const roleKey = roleKeyByLevel(getAdminLevel(req));
  const perms = loadPermissions();
  return !!(perms[roleKey] && perms[roleKey][feature]);
}

function allowedMenu(req){
  const roleKey = roleKeyByLevel(getAdminLevel(req));
  const perms = loadPermissions();
  return MENU.filter(item => !!(perms[roleKey] && perms[roleKey][item.key]));
}

function requireFeature(feature){
  return function(req,res,next){
    if (can(req, feature)) return next();
    return res.status(403).render ? res.status(403).render('error', {
      title: 'Доступ запрещён',
      message: 'Эта вкладка недоступна для вашего уровня доступа.'
    }) : res.status(403).send('Доступ запрещён');
  };
}

function requireLevel3(req,res,next){
  if (getAdminLevel(req) >= 3) return next();
  return res.status(403).render ? res.status(403).render('error', {
    title: 'Доступ запрещён',
    message: 'Доступ только для администратора 3 уровня.'
  }) : res.status(403).send('Доступ только для администратора 3 уровня');
}

module.exports = {
  FEATURES,
  DEFAULTS,
  MENU,
  FILE,
  loadPermissions,
  savePermissions,
  currentUser,
  getAdminLevel,
  roleKeyByLevel,
  can,
  allowedMenu,
  requireFeature,
  requireLevel3
};
