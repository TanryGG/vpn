<%- include('_layout_open') %><h1>Логи</h1><div class="table-wrap"><table><tr><th>ID</th><th>User</th><th>Action</th><th>Details</th><th>IP</th><th>Дата</th></tr><% logs.forEach(l=>{ %><tr><td><%= l.id %></td><td><%= l.email || '-' %></td><td><%= l.action %></td><td><%= l.details || '' %></td><td><%= l.ip || '' %></td><td><%= l.created_at %></td></tr><% }) %></table></div><%- include('_layout_close') %>