<%- include('_layout_open') %><h1>GPT статистика</h1><div class="stats"><div class="stat">Всего токенов<b><%= total.total_tokens || 0 %></b></div><div class="stat">Prompt<b><%= total.prompt_tokens || 0 %></b></div><div class="stat">Completion<b><%= total.completion_tokens || 0 %></b></div></div><div class="table-wrap"><table><tr><th>Email</th><th>Модель</th><th>Prompt</th><th>Completion</th><th>Total</th><th>Дата</th></tr><% rows.forEach(r=>{ %><tr><td><%= r.email %></td><td><%= r.model %></td><td><%= r.prompt_tokens %></td><td><%= r.completion_tokens %></td><td><%= r.total_tokens %></td><td><%= r.created_at %></td></tr><% }) %></table></div><%- include('_layout_close') %>